{
  "name": "@flowkit-io/themes",
  "version": "1.0.0",
  "description": "Design tokens and CSS variables themes for Flowkit (default: notion-clean).",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Massimo Moffa",
  "homepage": "https://github.com/MaxMoffa/flowkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxMoffa/flowkit.git",
    "directory": "packages/themes"
  },
  "keywords": [
    "flowkit",
    "theme",
    "design-tokens"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  }
}
