{
  "name": "@flowkit-io/react",
  "version": "0.14.2",
  "description": "React renderer and step components for Flowkit.",
  "license": "MIT",
  "author": "Massimo Moffa",
  "homepage": "https://github.com/MaxMoffa/flowkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxMoffa/flowkit.git",
    "directory": "packages/react"
  },
  "keywords": [
    "flowkit",
    "react",
    "form",
    "wizard"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lean": {
      "types": "./dist/lean.d.ts",
      "import": "./dist/lean.js"
    },
    "./steps/*": {
      "types": "./dist/steps/*.d.ts",
      "import": "./dist/steps/*.js"
    },
    "./style.css": "./src/style.css",
    "./map-maplibre": {
      "types": "./dist/map-maplibre.d.ts",
      "import": "./dist/map-maplibre.js"
    },
    "./map-leaflet": {
      "types": "./dist/map-leaflet.d.ts",
      "import": "./dist/map-leaflet.js"
    },
    "./payment-stripe": {
      "types": "./dist/payment-stripe.d.ts",
      "import": "./dist/payment-stripe.js"
    },
    "./verification": {
      "types": "./dist/verification.d.ts",
      "import": "./dist/verification.js"
    }
  },
  "files": [
    "dist",
    "src/style.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "maplibre-gl": "^4.7.1",
    "leaflet": "^1.9.4",
    "@stripe/stripe-js": "^9.0.0",
    "@stripe/react-stripe-js": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "@stripe/stripe-js": {
      "optional": true
    },
    "@stripe/react-stripe-js": {
      "optional": true
    }
  },
  "dependencies": {
    "@flowkit-io/core": "^0.12.0",
    "@flowkit-io/themes": "^0.4.0"
  },
  "devDependencies": {
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "@testing-library/react": "^16.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5"
  }
}
